              "path": ["api", "v1", "aigc", "word", "operate"]
            },
            "description": "为单词视频生成AI图片"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Image generation started\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(0);",
                  "    pm.expect(jsonData.data.status).to.be.oneOf([1, 2]); // IMG_GENERATING or IMG_REVIEWING",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 生成AI视频",
