              "raw": "{{baseUrl}}/api/v1/video-generation/collections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "video-generation", "collections"]
            },
            "description": "获取所有视频合集列表"
          },
          "response": []
        },
        {
