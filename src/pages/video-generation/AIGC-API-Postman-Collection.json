        {
          "name": "1.1 创建单词视频",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"series_name\": \"英语基础\",\n  \"title\": \"第1课-apple\",\n  \"word\": \"apple\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/aigc/word/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "aigc", "word", "create"]
            },
            "description": "创建一个新的单词视频任务"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has video ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(0);",
                  "    pm.expect(jsonData.data.id).to.exist;",
                  "    pm.collectionVariables.set(\"wordVideoId\", jsonData.data.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 生成AI图片",
